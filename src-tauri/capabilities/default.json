{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "shell:allow-execute",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-read-file",
    "fs:allow-exists",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        { "name": "bash", "sidecar": false, "cmd": "bash", "args": true }
      ]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        "$HOME/**",
        "$APP/**",
        "/tmp/**"
      ]
    }
  ]
}
